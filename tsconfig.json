{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["vitest.config.ts", "sanity.blueprint.ts", "functions/**/*.ts", "seed/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "hub/src/engine/**/*.ts"]
}
