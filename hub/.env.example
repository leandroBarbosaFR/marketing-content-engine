# Organization that owns the Sanity project (sanity.io/manage → Organization settings).
SANITY_APP_ORGANIZATION_ID=
# Set after the first `npm run deploy`, so later deploys update the same app.
SANITY_APP_ID=

# The project that holds vistra.com and gtm-brain. Identifiers only: everything in a
# SANITY_APP_* variable ends up in the browser bundle, so never put a token here.
SANITY_APP_PROJECT_ID=
SANITY_APP_WEBSITE_DATASET=production
SANITY_APP_GTM_DATASET=gtm-brain
# The deployed Studio, for "Open in Studio" links, e.g. https://vistra-marketing.sanity.studio
SANITY_APP_STUDIO_URL=
